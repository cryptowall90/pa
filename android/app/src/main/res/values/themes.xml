<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme; Compose drives the real styling. Splash/window background is black
         so the camera surface doesn't flash white on launch. -->
    <style name="Theme.PicturePerfectX" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
